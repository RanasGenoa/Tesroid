# Host port exposed by Docker Compose (mapped to container PORT)
TESROID_PORT=9001

# Internal server listening port inside the container
PORT=8080

# Persistent data directory inside the container
DATA_DIR=/data

# Virtual X11 display and browser UI locale / timezone
DISPLAY=:99
LOCALE=ja-JP
TZ=Asia/Tokyo

# Hardware encoder mode: auto | nvenc | vaapi | software
ENCODER_MODE=auto

# Optional explicit VAAPI render node or driver override (empty = automatic probe)
VAAPI_DEVICE=
LIBVA_DRIVER_NAME=

# Optional Cloudflare Tunnel connector token (enables built-in cloudflared)
TUNNEL_TOKEN=

# Optional telemetry log directory (defaults to ${DATA_DIR}/telemetry)
TELEMETRY_LOG_DIR=

# Buffer-Hold expiration timeout in minutes
BUFFER_HOLD_EXPIRE_MINUTES=10
