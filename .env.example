# ==============================================================================
# Tesroid Configuration (.env)
# ==============================================================================

# Host port exposed by Tesroid HTTP / WebSocket server
# Your HTTPS reverse proxy or Cloudflare Tunnel should forward to this port.
TESROID_PORT=9001

# Initial URL opened by the cloud browser on startup
BROWSER_URL=https://www.youtube.com

# Virtual display resolution and default encoding settings
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720
FPS=30
VIDEO_BITRATE=1000k

# VAAPI hardware acceleration settings
# - LIBVA_DRIVER_NAME: iHD (Intel Broadwell+), i965 (older Intel), radeonsi (AMD)
VAAPI_DEVICE=/dev/dri/renderD128
LIBVA_DRIVER_NAME=iHD

# ==============================================================================
# Remote Deployment Settings (Optional — used by ./scripts/deploy.sh)
# ==============================================================================
# DEPLOY_HOST=192.168.1.100
# DEPLOY_USER=root
# DEPLOY_PORT=22
# REMOTE_DIR=/opt/tesroid
# DEPLOY_MODE=compose   # "compose" (standard Docker Compose) or "truenas" (TrueNAS Custom App)
# DEPLOY_PASS=          # Leave empty to use standard SSH key authentication (recommended)
