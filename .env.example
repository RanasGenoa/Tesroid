# ==============================================================================
# Tesroid Configuration (.env)
# ==============================================================================

# Host port exposed by Tesroid HTTP / WebSocket server
# Your HTTPS reverse proxy or Cloudflare Tunnel should forward to this port.
TESROID_PORT=9001

# Initial URL opened by the cloud browser on startup
BROWSER_URL=https://www.youtube.com

# Virtual display resolution and default encoding settings
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720
FPS=30
VIDEO_BITRATE=1000k

# Hardware acceleration & encoder settings
# - ENCODER_MODE: auto (probe VAAPI, fall back to libx264 CPU), vaapi (strict HW), software (force libx264 CPU)
# - VAAPI_DEVICE: leave empty to auto-detect /dev/dri/renderD* (prefers Intel/AMD over NVIDIA)
# - LIBVA_DRIVER_NAME: leave empty to auto-detect, or set explicitly:
#     iHD (Intel Broadwell+), i965 (older Intel), radeonsi (AMD Linux), d3d12 (Windows Docker Desktop / WSL2)
ENCODER_MODE=auto
VAAPI_DEVICE=
LIBVA_DRIVER_NAME=

# Cloudflare Tunnel connector token (Optional)
# Obtain from Cloudflare Zero Trust -> Networks -> Tunnels (starts with "eyJh...").
# When set, the container's built-in cloudflared starts automatically. Leave empty to disable.
TUNNEL_TOKEN=

# ==============================================================================
# Remote Deployment Settings (Optional — used by ./scripts/deploy.sh)
# ==============================================================================
# DEPLOY_HOST=192.168.1.100
# DEPLOY_USER=root
# DEPLOY_PORT=22
# REMOTE_DIR=/opt/tesroid
# DEPLOY_MODE=compose   # "compose" (standard Docker Compose) or "truenas" (TrueNAS Custom App)
# DEPLOY_PASS=          # Leave empty to use standard SSH key authentication (recommended)
